# Q1: Supervised Learning - Heart Disease Prediction
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import classification_report, confusion_matrix

from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
df = pd.read_csv('../data/q1_heart_disease.csv')

print("Shape:", df.shape)
print("\nMissing Values:\n", df.isnull().sum())

df.head()
The dataset contains patient health details used to predict whether a person has heart disease.
sns.countplot(x='heart_disease', data=df)
plt.title("Heart Disease Distribution")
plt.show()
This plot shows how many patients have heart disease vs not. 
It helps to understand if the dataset is balanced.
plt.figure(figsize=(10,6))
sns.heatmap(df.corr(numeric_only=True), annot=True)
plt.title("Correlation Heatmap")
plt.show()
The heatmap shows relationships between features. 
Some features have stronger correlation with heart disease.
# Handle missing values
df.fillna(df.median(numeric_only=True), inplace=True)

# Convert categorical to numeric
df = pd.get_dummies(df, drop_first=True)

# Split features and target
X = df.drop('heart_disease', axis=1)
y = df['heart_disease']

# Scale features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Train-test split
X_train, X_test, y_train, y_test = train_test_split(
    X_scaled, y, test_size=0.2, stratify=y, random_state=42
)
Missing values are filled using median because it is less affected by extreme values.
Data is scaled to ensure all features have equal importance.
Among the models, Random Forest performs better based on precision, recall, and F1-score.
It handles complex relationships better than Decision Tree.
param_grid = {
    'n_estimators': [100, 200],
    'max_depth': [3, 5, 10]
}

grid = GridSearchCV(RandomForestClassifier(random_state=42),
                    param_grid, cv=3)

grid.fit(X_train, y_train)

print("Best Parameters:", grid.best_params_)
After tuning, the model performance improved slightly, showing better optimization.
